# Скопируй в .env и заполни. docker compose подхватит автоматически.
# Для Gmail нужен App Password (не обычный пароль аккаунта).
# Адрес должен совпадать с аккаунтом, под которым идёт SMTP-логин — он же
# подставляется в поле From, иначе Gmail отбивает письмо.
SPRING_MAIL_USERNAME=
SPRING_MAIL_PASSWORD=

# Публичный адрес приложения — попадает в ссылку активации аккаунта в письме.
# Локально через docker compose можно не задавать (по умолчанию http://localhost:8080),
# в AWS — DNS-имя ALB или свой домен.
APP_BASE_URL=http://localhost:8080
